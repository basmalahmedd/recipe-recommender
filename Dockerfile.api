# ---- Runtime image ----
FROM python:3.11-slim

# Prevents Python from writing .pyc files & enables unbuffered logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv

# System deps (usually not needed, but safe for pandas/numpy wheels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app code
COPY app ./app

# Copy processed data (built in step 0)
COPY data/processed/recipes.parquet ./data/processed/recipes.parquet

# Env defaults (you can override at 'docker run' time)
ENV DATA_PROCESSED=/srv/data/processed/recipes.parquet \
    K_MAX=10 \
    CORS_ORIGINS=*

EXPOSE 8000

# Start FastAPI
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]